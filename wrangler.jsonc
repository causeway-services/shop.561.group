{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop-561-group",
  "main": "src/worker.mjs",
  // Fail a direct Wrangler build/deploy before bundling if Shop's public service
  // projection can leak fields from the upstream seller record.
  "build": { "command": "node --check src/service-discovery.mjs && node --check src/external-stripe-payment-link-receiving.mjs && node --check src/worker.mjs && node --test test/service-discovery.test.mjs test/external-stripe-payment-link-receiving.test.mjs test/worker.test.mjs" },
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "services": [
    { "binding": "MARKET_SERVICE_CATALOG_FETCH", "service": "market-561-group" }
  ],
  "preview_urls": false,
  // Book covers, copied from each edition by scripts/compile-catalog.mjs.
  "assets": { "directory": "./public" },
  "routes": [
    {
      "pattern": "shop.561.group",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SHOP_FULFILLMENT", "class_name": "ShopFulfillment" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopFulfillment"] }],
  "kv_namespaces": [
    {
      "binding": "SHOP_ENTITLEMENTS",
      "id": "9372634aa5ca4c87937c6d3dd457bef6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHOP_GOODS",
      "bucket_name": "shop-561-group-goods"
    }
  ]
}

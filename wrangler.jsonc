{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop-561-group",
  "main": "src/worker.mjs",
  // Fail a direct Wrangler build/deploy before bundling if Shop's public service
  // projection can leak fields from the upstream seller record.
  "build": { "command": "node --check scripts/reconcile-authored-offer-links.mjs && node scripts/reconcile-authored-offer-links.mjs --check && node --check src/service-discovery.mjs && node --check src/service-market-x402-relay.mjs && node --check src/book-feed.mjs && node --check src/external-stripe-payment-link-receiving.mjs && node --check src/worker.mjs && node --check src/support-public-probe.mjs && node --check scripts/probe-public-support.mjs && node --check src/support-checkout-attribution.mjs && node --check scripts/reconcile-support-checkouts.mjs && node --test test/support-worker-routing.test.mjs test/support-public-probe.test.mjs test/support-checkout-attribution.test.mjs test/reconcile-authored-offer-links.test.mjs test/compile-catalog.test.mjs test/book-feed.test.mjs test/service-discovery.test.mjs test/service-market-x402-relay.test.mjs test/external-stripe-payment-link-receiving.test.mjs test/fulfillment-bindings.test.mjs test/worker.test.mjs test/support-campaign.test.mjs test/shop-commerce-integration.test.mjs test/receive-public-shop.test.mjs" },
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "services": [
    { "binding": "MARKET_SERVICE_CATALOG_FETCH", "service": "market-561-group" }
  ],
  "preview_urls": false,
  // Book covers, copied from each edition by scripts/compile-catalog.mjs.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/support", "/support/*", "/services/execute"]
  },
  "routes": [
    {
      "pattern": "shop.561.group",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SHOP_FULFILLMENT", "class_name": "ShopFulfillment" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopFulfillment"] }],
  "kv_namespaces": [
    {
      "binding": "SHOP_ENTITLEMENTS",
      "id": "9372634aa5ca4c87937c6d3dd457bef6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SHOP_GOODS",
      "bucket_name": "shop-561-group-goods"
    }
  ]
}

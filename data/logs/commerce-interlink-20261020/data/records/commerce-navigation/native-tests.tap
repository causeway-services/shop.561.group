eight:3px}\n.tufte-splitter:hover::after,.tufte-splitter:focus-visible::after{background:var(--tufte-accent)}\n.tufte-splitter:focus-visible{outline:2px solid var(--tufte-accent);outline-offset:-1px}\n@media(max-width:760px){.tufte-grid{grid-template-columns:repeat(6,minmax(0,1fr))}.tufte-tile,.tufte-tile[data-role=now],.tufte-tile[data-role=aside]{grid-column:span 6}.tufte-tile[data-role=rail]{grid-column:span 6}.tufte-masthead{display:block}.tufte-workspace{display:flex;flex-direction:column}.tufte-workspace>.tufte-tile{min-height:0}.tufte-splitter{display:none}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}.tufte-tile:has(.tufte-storefront-item)>header h2{font-size:1.05rem;letter-spacing:normal;text-transform:none;color:var(--tufte-ink)}#storefront-results .tufte-tile-body:empty{display:none}.tufte-storefront-item{display:grid;gap:1rem;min-width:0}.tufte-storefront-item :is(p,dd,li,code){overflow-wrap:anywhere}.tufte-storefront-item>p{margin:0}.tufte-storefront-item img{display:block;width:100%;max-height:20rem;object-fit:contain;border-radius:.35rem}.tufte-storefront-illustration{display:flex;align-items:center;justify-content:center;min-height:6rem}.tufte-storefront-illustration svg{width:5rem;height:5rem}.tufte-storefront-item dl{display:grid;grid-template-columns:auto 1fr;gap:.4rem 1rem;margin:0}.tufte-storefront-item dd{margin:0}.tufte-storefront-keywords{display:flex;gap:.5rem;flex-wrap:wrap;list-style:none;padding:0;margin:0}.tufte-storefront-keywords li{border:1px solid currentColor;border-radius:1rem;padding:.15rem .65rem;font-size:.8rem}.tufte-storefront-actions{display:flex;flex-wrap:wrap;gap:1rem;align-items:center}.tufte-storefront-actions p{margin:0}.tufte-storefront-actions a{display:inline-block;padding:.45rem .7rem;border:1px solid currentColor;border-radius:.3rem;text-decoration:none}.tufte-storefront-actions [aria-disabled=true]{o
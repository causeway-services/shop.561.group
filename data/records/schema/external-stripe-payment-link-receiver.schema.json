{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561:shop:external-stripe-payment-link-receiver:v1",
  "title": "External Stripe Payment Link audit receiver",
  "description": "Private Shop catalog source for source-selected external merchant Payment Link event observations. The original compiled Shop catalog carries it and the Worker passes only permitted link IDs to signed Stripe event receiving; it is not merchandise, entitlement, a customer, a paid invoice or Group treasury settlement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schemaVersion",
    "stripePaymentLinkId",
    "stripeMerchantAccountId",
    "merchantDisplayName",
    "supportedProgramName",
    "sourceObservedOn",
    "sourceRevision"
  ],
  "properties": {
    "type": {
      "const": "ExternalStripePaymentLinkReceiver"
    },
    "schemaVersion": {
      "const": 1
    },
    "stripePaymentLinkId": {
      "type": "string",
      "pattern": "^plink_[A-Za-z0-9]+$"
    },
    "stripeMerchantAccountId": {
      "type": "string",
      "pattern": "^acct_[A-Za-z0-9]+$",
      "description": "Observed Stripe account in the original owner source; not itself proof of legal payee or Group settlement"
    },
    "merchantDisplayName": {
      "type": "string",
      "minLength": 1
    },
    "supportedProgramName": {
      "type": "string",
      "minLength": 1
    },
    "sourceObservedOn": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commitSha",
        "path",
        "blobSha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "blobSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  }
}
